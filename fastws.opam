opam-version: "2.0"
synopsis: "Fast websocket library"
maintainer: ["Vincent Bernardoff <vb@luminar.eu.org>"]
authors: ["Vincent Bernardoff <vb@luminar.eu.org>"]
license: "ISC"
tags: ["websocket" "async"]
homepage: "https://github.com/deepmarker/ocaml-fastws"
doc: "https://deepmarker.github.io/fastws"
bug-reports: "https://github.com/deepmarker/ocaml-fastws/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml"
  "sexplib"
  "ppx_sexp_conv"
  "faraday"
  "httpun-types"
  "uutf"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/deepmarker/ocaml-fastws.git"
